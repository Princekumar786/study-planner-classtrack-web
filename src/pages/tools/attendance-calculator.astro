---
import Tool from '../../layouts/Tool.astro';
import type { QA } from '../../lib/schema';

const faqs: QA[] = [
  { q: 'How do I calculate my attendance percentage?', a: 'Divide the classes you attended by the total classes held, then multiply by 100. For example, 42 attended out of 53 is 42 ÷ 53 × 100 = 79.2%.' },
  { q: 'How many classes do I need to attend to reach 75%?', a: 'Use the formula x = (0.75 × total − attended) ÷ 0.25, rounded up. With 30 attended out of 45, you need (33.75 − 30) ÷ 0.25 = 15 more classes in a row. The calculator does this for any target.' },
  { q: 'How many classes can I miss and stay above 75%?', a: 'Use y = attended ÷ 0.75 − total, rounded down. With 42 attended out of 50, you can miss 42 ÷ 0.75 − 50 = 6 classes.' },
  { q: 'Do cancelled classes count?', a: 'Usually not: a class that did not happen should not be in the total. Check your college rules. In the ClassTrack app you can mark a class as cancelled so it never counts against you.' },
];
---
<Tool
  href="/tools/attendance-calculator/"
  metaTitle="Attendance Calculator: Percentage & Classes Needed for 75%"
  description="Free attendance percentage calculator. See your attendance %, how many classes you must attend to reach 75% (or any target), and how many you can safely miss."
  h1="Attendance <em style='color:var(--cta)'>calculator</em>"
  lead="Enter the classes you attended and the total held. See your percentage and exactly how many classes you need for your target."
  faqs={faqs}
  appTitle="Track it automatically"
  appText="Mark classes present, absent or cancelled in one tap in ClassTrack and see your percentage per subject. Free on Android."
>
  <div slot="tool">
    <div class="tool-panel">
      <div class="row">
        <div class="field"><label for="at-a">Classes attended</label><input id="at-a" type="number" min="0" value="42" inputmode="numeric" /></div>
        <div class="field"><label for="at-t">Total classes held</label><input id="at-t" type="number" min="0" value="53" inputmode="numeric" /></div>
        <div class="field"><label for="at-p">Target %</label><input id="at-p" type="number" min="1" max="100" value="75" inputmode="numeric" /></div>
      </div>
      <div class="result" id="at-box" aria-live="polite"><span class="small">Current attendance</span><div class="big" id="at-out">79.2%</div><p id="at-msg" style="margin:6px 0 0"></p></div>
    </div>
  </div>

  <h2>Attendance formulas</h2>
  <ul>
    <li><strong>Attendance % =</strong> attended ÷ total × 100</li>
    <li><strong>Classes needed to reach target p =</strong> ⌈(p × total − attended) ÷ (1 − p)⌉</li>
    <li><strong>Classes you can miss =</strong> ⌊attended ÷ p − total⌋</li>
  </ul>
  <p>Here p is the target as a decimal (75% = 0.75). Planning your week around classes? Try the <a href="/tools/timetable-maker/">timetable maker</a> or the <a href="/student-planner/">student planner</a>.</p>
</Tool>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  function run() {
    const a = Math.floor(Number($<HTMLInputElement>('at-a').value));
    const t = Math.floor(Number($<HTMLInputElement>('at-t').value));
    const p = Number($<HTMLInputElement>('at-p').value) / 100;
    const box = $('at-box'), out = $('at-out'), msg = $('at-msg');
    if (!(t > 0) || a < 0 || a > t || !(p > 0 && p <= 1)) {
      out.textContent = '—'; box.classList.remove('warn');
      msg.textContent = 'Attended must be between 0 and the total, and the target between 1 and 100.'; return;
    }
    const cur = a / t;
    out.textContent = (cur * 100).toFixed(1) + '%';
    if (cur >= p) {
      const y = Math.floor(a / p - t + 1e-9);
      box.classList.remove('warn');
      msg.innerHTML = y > 0 ? `You are on track. You can miss <strong>${y}</strong> class${y === 1 ? '' : 'es'} and stay at or above ${p * 100}%.` : `You are exactly on target. Missing the next class would take you below ${p * 100}%.`;
    } else if (p === 1) {
      box.classList.add('warn');
      msg.textContent = 'A 100% target can no longer be reached once a class is missed.';
    } else {
      const x = Math.ceil((p * t - a) / (1 - p) - 1e-9);
      box.classList.add('warn');
      msg.innerHTML = `You are below ${p * 100}%. Attend the next <strong>${x}</strong> class${x === 1 ? '' : 'es'} in a row to reach it.`;
    }
  }
  ['at-a', 'at-t', 'at-p'].forEach((id) => $(id).addEventListener('input', run));
  run();
</script>
