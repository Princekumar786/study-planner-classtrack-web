---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import AppBand from '../components/AppBand.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { faqSchema, appSchema, type QA } from '../lib/schema';

// Mirrors planComparison in the app (lib/features/subscription/domain/upgrade_reason.dart).
const rows: [string, string, string][] = [
  ['Class timetable, reminders & widget', '✓', '✓'],
  ['Homework, assignments & exam countdowns', '✓', '✓'],
  ['Grades & GPA', '✓', '✓'],
  ['Habit tracker', '✓', '✓'],
  ['AI study assistant', `${SITE.free.aiMessages} messages / month`, 'Unlimited'],
  ['AI timetable scans (photo, PDF, text)', String(SITE.free.timetableScans), 'Unlimited'],
  ['AI learning plans', String(SITE.free.learningPlans), 'Unlimited'],
  ['Smart notes & flashcards', '—', '✓'],
  ['Google Calendar & Tasks daily auto-import', '—', '✓'],
  ['PDF, CSV & calendar export', '—', '✓'],
  ['Daily AI agenda summary', '—', '✓'],
  ['Insights & predictions', '—', '✓'],
  ['Semester wrap-up, SGPA & CGPA', '—', '✓'],
  ['Scholarships, internships & perks', 'Latest 5', 'All, with search'],
  ['Quiet hours & reminder controls', '—', '✓'],
  ['Custom accent colours', '—', '✓'],
];
const faqs: QA[] = [
  { q: 'How much does ClassTrack Pro cost?', a: 'Pro is sold as a subscription through Google Play. Prices are shown in your local currency inside the app before you buy, and can differ by country and include introductory offers. Monthly, multi-month and yearly plans are available.' },
  { q: 'Is there a free trial?', a: 'Some plans include a free trial or introductory price. If one is available in your country, it is shown on the plan card in the app before you subscribe.' },
  { q: 'How do I cancel?', a: 'Open Google Play → Profile → Payments & subscriptions → Subscriptions, choose ClassTrack and tap Cancel. You keep Pro until the end of the period you paid for.' },
  { q: 'Are the website tools free?', a: 'Yes. Every tool on studyplanner.tech is free, with no account and no limits.' },
  { q: 'Do I lose my data if I stop paying?', a: 'No. Your timetable, tasks, exams and grades stay in your account on the free plan. Pro-only features stop until you subscribe again.' },
];
---
<Base title="ClassTrack Pricing: Free Study Planner, Optional Pro" description="ClassTrack is free: timetable, homework, exams, grades and reminders. Pro adds unlimited AI, timetable scans, flashcards and Google Calendar import." crumbs={[{ name: 'Pricing', href: '/pricing/' }]} schema={[appSchema(), faqSchema(faqs)]}>
  <section class="section center" style="padding-top:40px">
    <div class="wrap">
      <span class="eyebrow">Pricing</span>
      <h1>Plan for <em style="color:var(--cta)">free</em>. Upgrade if you want more AI.</h1>
      <p class="lead">The study planner, timetable, homework and exams are free forever. Pro removes the AI limits and adds power features.</p>
    </div>
    <div class="wrap grid g2 plans" style="margin-top:48px;text-align:left;max-width:900px">
      <div class="card t-mint">
        <h2 style="font-size:1.6rem">Free</h2>
        <p class="price">Free <span>forever</span></p>
        <ul class="ticks">
          <li><Icon name="check" />Timetable, homework, exams, grades</li>
          <li><Icon name="check" />{SITE.free.aiMessages} AI messages a month</li>
          <li><Icon name="check" />{SITE.free.timetableScans} AI timetable scans</li>
          <li><Icon name="check" />{SITE.free.learningPlans} AI learning plans</li>
          <li><Icon name="check" />All 8 web tools</li>
        </ul>
        <a class="btn" href={SITE.playUrl} rel="noopener" style="width:100%">Get ClassTrack free</a>
      </div>
      <div class="card t-lavender">
        <h2 style="font-size:1.6rem">Pro</h2>
        <p class="price">Monthly or yearly <span>price shown in app</span></p>
        <ul class="ticks">
          <li><Icon name="check" />Everything in Free</li>
          <li><Icon name="check" />Unlimited AI assistant, scans and plans</li>
          <li><Icon name="check" />Notes &amp; flashcards</li>
          <li><Icon name="check" />Daily Google Calendar import</li>
          <li><Icon name="check" />Semester wrap-up, SGPA &amp; CGPA</li>
        </ul>
        <a class="btn" href={SITE.playUrl} rel="noopener" style="width:100%">Try Pro in the app</a>
      </div>
    </div>
    <p class="small muted" style="margin-top:16px">Billed through Google Play. Auto-renews until you cancel in Play Store › Subscriptions.</p>
  </section>

  <section class="section tight">
    <div class="narrow">
      <h2 class="center" style="font-size:clamp(1.6rem,3vw,2.2rem)">Compare plans</h2>
      <div class="out-table prose">
        <table>
          <thead><tr><th scope="col">Feature</th><th scope="col">Free</th><th scope="col">Pro</th></tr></thead>
          <tbody>{rows.map(([f, a, b]) => <tr><td>{f}</td><td>{a}</td><td><strong>{b}</strong></td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section band-lavender"><div class="wrap center"><h2>Pricing questions</h2></div><Faq items={faqs} supportLink /></section>
  <AppBand />
</Base>

<style>
  .price { font-size: 2.4rem; font-weight: 700; letter-spacing: -0.03em; margin: 0 0 18px; line-height: 1.1; }
  .price span { display: block; font-size: .9rem; font-weight: 500; color: var(--ink-2); letter-spacing: 0; }
  .plans .card:last-child .price { font-size: 1.6rem; }
  .ticks { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 10px; }
  .ticks li { display: flex; gap: 10px; align-items: center; }
  .ticks :global(svg) { width: 20px; color: var(--cta); flex: none; }
</style>
