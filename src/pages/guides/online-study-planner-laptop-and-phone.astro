const steps = [
  { id: 'step-1', name: 'Pick one synced planner and put everything in it', text: 'Choose one online study planner that works in a browser and on your phone, and add your class timetable, every exam date and all open homework. One list you trust beats three you half use.' },
  { id: 'step-2', name: 'Do a 20-minute weekly review on your laptop', text: 'Once a week at a fixed time, open the planner on a laptop. Clear the inbox, check exam countdowns, move unfinished tasks and book study blocks with a day, time, place and task.' },
  { id: 'step-3', name: 'Leave 20% of the week empty', text: 'Students underestimate how long work takes. Keep about a fifth of your study time unbooked so the plan survives a late class or a hard topic.' },
  { id: 'step-4', name: 'Check the day on your phone each morning', text: 'Spend two minutes on your phone: see today’s classes, what is due and which study block comes next.' },
  { id: 'step-5', name: 'Capture homework on your phone the moment it is set', text: 'Add every assignment with a subject and due date before you leave the room. It takes ten seconds and stops tasks living in your head.' },
  { id: 'step-6', name: 'Study with the phone in another room', text: 'Work from the laptop and keep the phone out of sight. Even a silent phone on the desk takes up attention.' },
  { id: 'step-7', name: 'Close the day in five minutes', text: 'Tick off what you finished, move what you did not, and write tomorrow’s first task so you know exactly how to start.' },
];

const howTo = {
  '@type': 'HowTo',
  name: 'How to use an online study planner on a laptop and a phone',
  description: 'A weekly and daily routine for students: plan on a laptop, follow the plan and capture homework on a phone.',
  totalTime: 'PT20M',
  tool: [{ '@type': 'HowToTool', name: 'An online study planner that syncs between a browser and a phone, such as ClassTrack' }],
  step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text, url: `${SITE.url}${href}#${s.id}` })),
};
