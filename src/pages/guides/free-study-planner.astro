const itemList = {
  '@type': 'ItemList',
  name: 'Best free study planners for students in 2026',
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  numberOfItems: picks.length,
  itemListElement: picks.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: `${p.name}: ${p.best}`, url: `${SITE.url}${href}#${p.id}` })),
};

const steps = [
  { id: 'step-1', name: 'Pick one free planner', text: 'Choose a free study planner that works on the devices you use every day. If you use a laptop and a phone, pick one that syncs between a browser and an app.' },
  { id: 'step-2', name: 'Add your class timetable', text: 'Enter every class once with its day, time and room. Some free planners can read your timetable from a photo or PDF.' },
  { id: 'step-3', name: 'Add every exam and deadline', text: 'Add each exam, test and assignment with its date, even small quizzes, so you can see what is coming in the next two weeks.' },
  { id: 'step-4', name: 'Turn each exam into study sessions', text: 'Split the syllabus into topics and spread them across the days before the exam, leaving the last fifth of the time for revision and practice tests.' },
  { id: 'step-5', name: 'Book 2–4 study blocks a day', text: 'Place focused 25–50 minute blocks around your classes. Give each block a subject and a specific task.' },
  { id: 'step-6', name: 'Review it once a week', text: 'Spend 15–20 minutes each week moving unfinished tasks and booking next week. A plan you never review stops matching real life.' },
];

const howTo = {
  '@type': 'HowTo',
  name: 'How to set up a free study planner',
  description: 'Six steps to turn your classes, exams and homework into a weekly study plan in a free study planner.',
  totalTime: 'PT30M',
  estimatedCost: { '@type': 'MonetaryAmount', currency: 'USD', value: '0' },
  tool: [{ '@type': 'HowToTool', name: 'A free study planner app, web app or printable template' }],
  step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.name, text: s.text, url: `${SITE.url}${href}#${s.id}` })),
};
