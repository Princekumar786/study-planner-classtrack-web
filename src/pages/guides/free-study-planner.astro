  <table>
    <thead><tr><th scope="col">Planner</th><th scope="col">Free on</th><th scope="col">Free plan includes</th><th scope="col">Main free limits</th><th scope="col">Paid upgrade</th></tr></thead>
    <tbody>
      <tr><td><strong>ClassTrack</strong></td><td>Android, web</td><td>Timetable, homework, exams, grades, attendance, habits, reminders (Android)</td><td>{f.aiMessages} AI messages a month, {f.timetableScans} AI timetable scans, {f.learningPlans} AI learning plans</td><td>Pro subscription</td></tr>
      <tr><td><strong>MyStudyLife</strong></td><td>iPhone, iPad, Android, web</td><td>Classes (including rotating timetables), homework, exams, reminders, grades</td><td>Some features need a paid in-app upgrade</td><td>In-app purchases</td></tr>
      <tr><td><strong>Power Planner</strong></td><td>iPhone, Android, Windows, Mac, Chromebook, web (beta)</td><td>Classes, tasks, reminders, grades and GPA; ad-free</td><td>1 semester, 5 grades per class, 1 photo per item</td><td>One-time $4.99</td></tr>
