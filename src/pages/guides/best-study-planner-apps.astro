      <tr><td><strong>Structured</strong></td><td>As events</td><td>Tasks</td><td>No</td><td>No</td><td>Pro</td><td>Apple, Android, web</td><td>Free + Pro</td></tr>
      <tr><td><strong>Todoist</strong></td><td>No</td><td>Yes</td><td>No</td><td>No</td><td>Limited</td><td>All</td><td>Free + Pro</td></tr>
