---
import Guide from '../../layouts/Guide.astro';
import { SITE } from '../../data/site';
const href = '/guides/how-to-use-a-study-planner-app/';

// The 6 set-up steps. Used for the on-page list and the HowTo schema,
// so the page and structured data always match.
const steps = [
  { id: 'step-1', name: 'Import your class timetable', text: 'Add every class once, with day, time, room and teacher. In ClassTrack you can take a photo of your timetable, upload the PDF or paste the text and let AI build the week.' },
  { id: 'step-2', name: 'Add every exam date', text: 'Enter each test, final or entrance exam with its date so the app can count down and you can see which exam is closest.' },
  { id: 'step-3', name: 'Capture homework the moment it is set', text: 'Add each assignment with a subject and due date. Split big projects into smaller tasks with their own dates.' },
  { id: 'step-4', name: 'Turn each exam into a study plan', text: 'Break the syllabus into topics, estimate time for each and spread them across the days before the exam, leaving the last 20% for revision and practice tests.' },
  { id: 'step-5', name: 'Book study blocks around your classes', text: 'Pick 2–4 focused blocks per day in the gaps between classes, work and rest, and give each block one subject and one task.' },
  { id: 'step-6', name: 'Review the plan every week', text: 'Once a week, move unfinished tasks, log your grades and adjust next week so the plan matches real life.' },
];

const howTo = {
  '@type': 'HowTo',
  name: 'How to set up a study planner app',
  description: 'Six steps to turn your classes, homework and exam dates into a weekly study plan in a study planner app.',
  totalTime: 'PT20M',
  tool: [{ '@type': 'HowToTool', name: 'ClassTrack study planner app (Android) or any student planner' }],
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.name,
    text: s.text,
    url: `${SITE.url}${href}#${s.id}`,
  })),
};
---
<Guide
