  tldr={[
    'A routine works because it <strong>removes decisions</strong>. You stop debating whether to study and just follow the plan.',
    'Attach study to an <strong>existing anchor</strong> (after dinner, after your last class) so the habit has a trigger.',
    'Start <strong>smaller than feels necessary</strong>. A routine you keep beats an ambitious one you abandon in a week.',
    'Build in review and rest daily, not just new work, so the routine is sustainable.',
  ]}
  toc={[
    { id: 'why', label: 'Why routines beat willpower' },
    { id: 'build', label: 'Build yours in four steps' },
    { id: 'sample', label: 'A sample daily routine' },
    { id: 'stick', label: 'Make it stick' },
    { id: 'faq', label: 'FAQ' },
  ]}
  tools={['/tools/timetable-maker/', '/tools/study-plan-generator/', '/tools/pomodoro-timer/']}
  faqs={[
    { q: 'How long does it take to build a study habit?', a: 'In Lally\u2019s research, habits took a median of about 66 days to feel automatic, ranging widely by person and habit. Expect weeks, not days, and judge yourself on consistency rather than perfection.' },
    { q: 'What should a daily study routine include?', a: 'A fixed start time, one or two focused blocks with breaks, a short review of earlier material, and a clear finish. Reviewing old work daily is what most routines forget.' },
    { q: 'What if I miss a day?', a: 'Miss once, never twice. One missed day is noise; two in a row is how routines die. Get back to it the next day without trying to make up all the lost time at once.' },
  ]}
