---
// iPhone waitlist: any element with [data-ios] opens this dialog.
// Submits to Pageclip (form "iphone-waitlist"). Included once in Base.astro.
import { SITE } from '../data/site';
const action = `https://send.pageclip.co/${SITE.pageclipKey}/iphone-waitlist`;
---
<dialog id="ios-dialog" class="ios-dialog" aria-labelledby="ios-title">
  <button type="button" class="ios-x" data-ios-close aria-label="Close">✕</button>
  <div class="ios-head">
    <span class="ios-logo" aria-hidden="true"><svg viewBox="0 0 384 512" width="26" height="26"><path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg></span>
    <div>
      <h2 id="ios-title">ClassTrack for iPhone is coming</h2>
      <p>Leave your email and we will tell you the day it lands on the App Store. No spam, one email.</p>
    </div>
  </div>
  <form action={action} class="pageclip-form ios-form" method="post">
    <div class="field"><label for="ios-email">Email</label><input id="ios-email" type="email" name="email" required autocomplete="email" placeholder="you@example.com" /></div>
    <div class="row">
      <div class="field"><label for="ios-name">First name (optional)</label><input id="ios-name" name="name" autocomplete="given-name" maxlength="40" /></div>
      <div class="field"><label for="ios-who">I am a…</label>
        <select id="ios-who" name="student_type"><option>School student</option><option>College / university student</option><option>Preparing for an entrance exam</option><option>Teacher / parent</option><option>Other</option></select>
      </div>
    </div>
    <input type="hidden" name="subject" value="iPhone waitlist signup" />
    <input type="hidden" name="page" value="" data-page />
    <button class="btn pageclip-form__submit" type="submit" style="width:100%"><span>Notify me</span></button>
    <p class="small muted" style="margin:10px 0 0">We only use your email to tell you about the iPhone launch. See our <a href="/privacy/">privacy policy</a>.</p>
  </form>
</dialog>

<style>
  .ios-dialog { border: 0; border-radius: var(--r-lg); padding: 28px; width: min(520px, calc(100% - 32px)); color: var(--ink); }
  .ios-dialog::backdrop { background: rgba(18, 20, 42, .55); }
  .ios-x { position: absolute; top: 12px; right: 12px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--lavender); cursor: pointer; font-size: 1rem; }
  .ios-head { display: grid; grid-template-columns: auto 1fr; gap: 16px; align-items: start; margin-bottom: 18px; padding-right: 36px; }
  .ios-logo { width: 52px; height: 52px; border-radius: 14px; background: var(--ink); color: #fff; display: grid; place-items: center; }
  .ios-head h2 { font-size: 1.3rem; margin: 2px 0 6px; }
  .ios-head p { margin: 0; color: var(--ink-2); font-size: .95rem; }
  :global(.pageclip-form__success__message) { font-weight: 600; padding: 12px 0; }
</style>

<script>
  const dlg = document.getElementById('ios-dialog') as HTMLDialogElement | null;
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('[data-ios]');
    if (t && dlg) {
      e.preventDefault();
      const page = dlg.querySelector<HTMLInputElement>('[data-page]');
      if (page) page.value = location.pathname;
      dlg.showModal();
      // @ts-ignore gtag is defined in the head when analytics loads
      window.gtag?.('event', 'ios_waitlist_open', { page_path: location.pathname });
    }
    if ((e.target as HTMLElement).closest('[data-ios-close]')) dlg?.close();
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.querySelector('form')?.addEventListener('submit', () => {
    // @ts-ignore
    window.gtag?.('event', 'generate_lead', { form: 'iphone-waitlist' });
  });
</script>
