---
import { MAIN_NAV, PLANNERS, TOOLS, SITE } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---
<header class="nav">
  <div class="wrap nav-in">
    <a class="logo" href="/" aria-label="Study Planner home">
      <img src="/img/app-icon.webp" alt="" width="32" height="32" />
      <b>Study <span>Planner</span></b>
    </a>
    <nav class="nav-links" aria-label="Main">
      <details class="drop" data-close>
        <summary>Planners <Icon name="chevron" /></summary>
        <div class="drop-panel">
          {PLANNERS.map((p) => (
            <a href={p.href}><strong>{p.label}</strong><small>{p.desc}</small></a>
          ))}
        </div>
      </details>
      {MAIN_NAV.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="nav-right">
      <a class="util" href="/tools/timetable-maker/">Timetable maker</a>
      <a class="util" href="/about/">About</a>
      <a class="btn sm" href={SITE.playUrl} rel="noopener"><span>Get<span class="hide-xs"> the</span> app</span></a>
      <details class="menu-btn" data-close>
        <summary aria-label="Open menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="mobile-panel">
          <p>Planners</p>
          {PLANNERS.map((p) => <a href={p.href}>{p.label}</a>)}
          <p>Free tools</p>
          {TOOLS.slice(0, 5).map((t) => <a href={t.href}>{t.label}</a>)}
          <p>More</p>
          {MAIN_NAV.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="/about/">About</a>
          <a href="/faq/">FAQ</a>
        </div>
      </details>
    </div>
  </div>
</header>
