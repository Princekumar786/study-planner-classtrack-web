---
// Store badges: Google Play (live) + App Store (opens iPhone waitlist).
import { SITE } from '../data/site';
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<div class:list={['badges', { dark }]}>
  <a class="store" href={SITE.playUrl} rel="noopener" aria-label="Get ClassTrack on Google Play">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#34A853" d="M3.6 2.2 13.4 12l-9.8 9.8c-.4-.2-.6-.7-.6-1.2V3.4c0-.5.2-1 .6-1.2z"/><path fill="#FBBC04" d="m16.8 15.4-3.4-3.4 3.4-3.4 3.9 2.2c1.1.6 1.1 1.7 0 2.4z"/><path fill="#EA4335" d="M16.8 15.4 13.4 12l-9.8 9.8c.4.3 1 .2 1.6-.1z"/><path fill="#4285F4" d="M16.8 8.6 5.2 2.3c-.6-.3-1.2-.4-1.6-.1l9.8 9.8z"/></svg>
    <span><small>GET IT ON</small><strong>Google Play</strong></span>
  </a>
  <button type="button" class="store" data-ios aria-haspopup="dialog" aria-label="iPhone version coming soon: join the waitlist">
    <svg viewBox="0 0 384 512" aria-hidden="true"><path fill="currentColor" d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/></svg>
    <span><small>COMING SOON ON</small><strong>App Store</strong></span>
  </button>
</div>

<style>
  .badges { display: flex; flex-wrap: wrap; gap: 10px; }
  .store { display: inline-flex; align-items: center; gap: 10px; background: #000; color: #fff; border: 0; border-radius: 10px; padding: 8px 16px 8px 12px; text-decoration: none; cursor: pointer; font-family: var(--font); text-align: left; transition: transform .2s; }
  .store:hover { transform: translateY(-2px); color: #fff; }
  .dark .store { box-shadow: inset 0 0 0 1px #4a4a5a; }
  .store svg { width: 22px; height: 22px; flex: none; }
  .store small { display: block; font-size: .62rem; line-height: 1; letter-spacing: .04em; }
  .store strong { display: block; font-size: 1.05rem; line-height: 1.15; font-weight: 600; }
</style>
