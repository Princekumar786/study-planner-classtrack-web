---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/400-italic.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/poppins/700-italic.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IosWaitlist from '../components/IosWaitlist.astro';
import { SITE } from '../data/site';

export interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  crumbs?: Crumb[];
  noindex?: boolean;
  published?: string;
  modified?: string;
}
const { title, description, image = '/og-default.png', type = 'website', schema = [], crumbs, noindex = false, published, modified } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const ORG_ID = `${SITE.url}/#org`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: 'ClassTrack',
    alternateName: ['StudyPlanner.tech', 'ClassTrack Study Planner'],
    url: `${SITE.url}/`,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png`, width: 512, height: 512 },
    email: SITE.email,
    founder: { '@type': 'Person', '@id': `${SITE.url}/about/#prince-kumar`, name: SITE.author.name, url: SITE.author.url, sameAs: [SITE.author.site] },
    sameAs: [SITE.appSite, SITE.playUrl],
    contactPoint: { '@type': 'ContactPoint', email: SITE.email, contactType: 'customer support', availableLanguage: ['English', 'Hindi'] },
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: 'Free study planner, timetable maker, exam planner and student planning tools, by the makers of the ClassTrack app.',
    publisher: { '@id': ORG_ID },
    inLanguage: 'en',
  },
];
if (crumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href })),
  });
}
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...graph, ...schema] }).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Google Tag Manager -->
  <script is:inline define:vars={{ gtmId: SITE.gtm }}>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);</script>
  <!-- Google tag (gtag.js) -->
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4}`}></script>
  <script is:inline define:vars={{ gaId: SITE.ga4 }}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('js',new Date());gtag('config',gaId);</script>
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="stylesheet" href="https://s.pageclip.co/v1/pageclip.css" media="screen" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
  <meta name="author" content={SITE.author.name} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly summary" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
  <meta name="google-play-app" content={`app-id=${SITE.playId}`} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={SITE.locale} />
  {published && <meta property="article:published_time" content={published} />}
  {modified && <meta property="article:modified_time" content={modified} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={ld} />
  <slot name="head" />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
  <a class="skip" href="#main">Skip to content</a>
  <Nav />
  <main id="main">
    {crumbs?.length && (
      <nav class="crumbs wrap" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}
        </ol>
      </nav>
    )}
    <slot />
  </main>
  <Footer />
  <IosWaitlist />
  <script is:inline src="https://s.pageclip.co/v1/pageclip.js" charset="utf-8"></script>
  <script>
    // Nav border on scroll
    const nav = document.querySelector('.nav');
    const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Close open dropdowns on outside click or Escape
    document.addEventListener('click', (e) => {
      document.querySelectorAll<HTMLDetailsElement>('details[data-close]').forEach((d) => {
        if (d.open && !d.contains(e.target as Node)) d.open = false;
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll<HTMLDetailsElement>('details[data-close][open]').forEach((d) => {
        d.open = false;
        d.querySelector('summary')?.focus();
      });
    });

    // Carousels: arrows + dash pagination
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('.track');
      if (!track) return;
      const items = Array.from(track.children) as HTMLElement[];
      const dashes = root.querySelector('.dashes');
      const btns = items.map((_, i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('aria-label', `Go to slide ${i + 1} of ${items.length}`);
        b.addEventListener('click', () => go(i));
        dashes?.appendChild(b);
        return b;
      });
      const current = () => {
        const mid = track.scrollLeft + track.clientWidth / 2;
        let best = 0, dist = Infinity;
        items.forEach((el, i) => {
          const d = Math.abs(el.offsetLeft + el.offsetWidth / 2 - mid);
          if (d < dist) { dist = d; best = i; }
        });
        return best;
      };
      const go = (i: number) => {
        const el = items[Math.max(0, Math.min(items.length - 1, i))];
        track.scrollTo({ left: el.offsetLeft - (track.clientWidth - el.offsetWidth) / 2, behavior: 'smooth' });
      };
      const sync = () => {
        const c = current();
        btns.forEach((b, i) => b.setAttribute('aria-current', String(i === c)));
        items.forEach((el, i) => el.classList.toggle('is-active', i === c));
      };
      root.querySelector('[data-prev]')?.addEventListener('click', () => go(current() - 1));
      root.querySelector('[data-next]')?.addEventListener('click', () => go(current() + 1));
      let t: number | undefined;
      track.addEventListener('scroll', () => { window.clearTimeout(t); t = window.setTimeout(sync, 60); }, { passive: true });
      const start = Number(root.dataset.start ?? 0);
      if (start) requestAnimationFrame(() => { track.scrollLeft = items[start].offsetLeft - (track.clientWidth - items[start].offsetWidth) / 2; sync(); });
      sync();
    });
  </script>
</body>
</html>
