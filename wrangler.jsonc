{
  // Cloudflare Workers static-assets deploy. Having this file stops
  // `wrangler deploy` from auto-adding the @astrojs/cloudflare adapter:
  // the site is fully static, so no server code is needed.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "study-planner-classtrack-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
